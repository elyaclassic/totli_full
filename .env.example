# TOTLI Business System — muhim o'zgaruvchilar
# Nusxalang: .env.example ni .env ga nusxalab, qiymatlarni to'ldiring.

# Session va CSRF uchun maxfiy kalit (majburiy production da).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# Production rejimi (1, true, yes bo'lsa SECRET_KEY default qiymatda ishlatilmaydi)
# PRODUCTION=0

# HTTPS (proxy orqali SSL bo'lsa 1 qiling)
# HTTPS=0

# Ma'lumotlar bazasi (agar SQLite dan boshqasini ishlatsangiz)
# DATABASE_URL=sqlite:///./totli.db
